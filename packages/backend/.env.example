# Set in the Convex dashboard via: npx convex env set KEY value
OPENAI_API_KEY=

# Optional embedder/reranker providers. Each unlocks its choice in the retriever
# wizard only when set; unset providers show as "(key not set)" and are disabled.
OPENROUTER_API_KEY=
COHERE_API_KEY=
JINA_API_KEY=
VOYAGE_API_KEY=

# Tarser content service (optional). When all three are set, the Tarser scraper/parser
# backend becomes available. Leave unset in production to keep Tarser disabled.
TARSER_BASE_URL=
TARSER_API_TOKEN=
TARSER_CALLBACK_HMAC_SECRET=
# Local-dev only: force the callback host the Tarser container can reach
# (Docker Desktop reaches the host via host.docker.internal, NOT localhost).
# e.g. http://host.docker.internal:<convex-http-port>
TARSER_CALLBACK_BASE_URL=
